						{
							"type": "PARAGRAPH",
							"value": [
								{
									"type": "PLAIN_TEXT",
									"value": "*"
								},
								{
									"type": "BOLD",
									"value": [
										{
											"type": "PLAIN_TEXT",
											"value": "bold italic"
										}
									]
								},
								{
									"type": "PLAIN_TEXT",
									"value": "*"
								}
							]
						}
					]
				},
				{
					"name": "does not treat \"** **\" as a horizontal rule",
					"input": "** **",
					"matcher": "toEqual",
					"expected": [
						{
							"type": "PARAGRAPH",
							"value": [
								{
									"type": "PLAIN_TEXT",
									"value": "** **"
								}
							]
						}
					]
				},
				{
					"name": "does not treat \"- item\" as a horizontal rule",
					"input": "- item",
					"matcher": "toEqual",
					"expected": [
						{
							"type": "UNORDERED_LIST",
