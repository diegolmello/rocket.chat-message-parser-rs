			"cases": [
				{
					"name": "parses \"¯\\\\\\\\_(ツ)_/¯\"",
					"input": "¯\\\\_(ツ)_/¯",
					"matcher": "toEqual",
					"expected": [
						{
							"type": "PARAGRAPH",
							"value": [
								{
									"type": "PLAIN_TEXT",
									"value": "¯\\_(ツ)_/¯"
								}
							]
						}
					]
				},
				{
					"name": "parses \"\\\\*escaped as*bold*escaped*\"",
					"input": "\\*escaped as*bold*escaped*",
					"matcher": "toEqual",
					"expected": [
						{
							"type": "PARAGRAPH",
							"value": [
								{
									"type": "PLAIN_TEXT",
									"value": "*escaped as"
								},
								{
									"type": "BOLD",
									"value": [
										{
											"type": "PLAIN_TEXT",
											"value": "bold"
										}
									]
								},
								{
									"type": "PLAIN_TEXT",
									"value": "escaped*"
								}
							]
						}
					]
				},
